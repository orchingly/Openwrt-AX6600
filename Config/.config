# ========== L2TP/IPsec VPN 客户端完整支持 ==========

# --- 内核加密与IPsec基础模块 ---
CONFIG_PACKAGE_kmod-crypto-authenc=m
CONFIG_PACKAGE_kmod-crypto-cbc=m
CONFIG_PACKAGE_kmod-crypto-des=m
CONFIG_PACKAGE_kmod-crypto-echainiv=m
CONFIG_PACKAGE_kmod-crypto-md5=m
CONFIG_PACKAGE_kmod-crypto-gcm=m          # 推荐：AES-GCM
CONFIG_PACKAGE_kmod-crypto-sha256=m       # 推荐：SHA256
CONFIG_PACKAGE_kmod-crypto-sha512=m       # 推荐：SHA512

CONFIG_PACKAGE_kmod-ipsec=m
CONFIG_PACKAGE_kmod-ipsec4=m
CONFIG_PACKAGE_kmod-ipsec6=m

# --- PPP 及 L2TP 内核支持 ---
CONFIG_PACKAGE_kmod-ppp=m
CONFIG_PACKAGE_kmod-pppol2tp=m

# --- 用户态软件包 ---
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_xl2tpd=y
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-ipsec=y
CONFIG_PACKAGE_strongswan-mod-kernel-netlink=y
CONFIG_PACKAGE_strongswan-mod-openssl=y
CONFIG_PACKAGE_strongswan-mod-socket-default=y
CONFIG_PACKAGE_strongswan-swanctl=y
CONFIG_PACKAGE_strongswan-mod-charon=y
CONFIG_PACKAGE_strongswan-mod-vici=y
CONFIG_PACKAGE_strongswan-mod-gmp=y

# --- LuCI Web 界面支持 ---
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-l2tp=y
CONFIG_PACKAGE_luci-proto-ipsec=y          # 可选，有些主题需要
CONFIG_PACKAGE_luci-app-strongswan-swanctl=y
